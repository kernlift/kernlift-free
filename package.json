{
	"name": "kernlift-free",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"typecheck": "tsc --noEmit",
		"setup": "node scripts/setup.mjs",
		"admin": "node scripts/admin.mjs",
		"test": "node --test scripts/test.mjs",
		"check": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
		"validate:foundation": "node --import tsx --test scripts/validate/foundation.mjs",
		"validate:providers": "node --import tsx --test scripts/validate/providers.mjs",
		"validate:all": "pnpm validate:foundation && pnpm validate:providers && pnpm test"
	},
	"dependencies": {
		"@tanstack/react-router": "1.170.16",
		"@tanstack/react-start": "1.168.26",
		"better-auth": "1.6.19",
		"nodemailer": "^10.6.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"lucide-react": "1.20.0",
		"motion": "13.2.0",
		"recharts": "3.8.0",
		"@base-ui/react": "1.5.0",
		"@tanstack/react-virtual": "3.14.13",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"tailwind-merge": "3.6.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "25.9.3",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"nitro": "3.0.261029-rc",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"tailwindcss": "4.3.1",
		"@tailwindcss/vite": "4.3.1"
	},
	"license": "MIT"
}
